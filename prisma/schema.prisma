generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Trip {
  id        Int      @id @default(autoincrement())
  name      String
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cities    City[]
}

model City {
  id          Int       @id @default(autoincrement())
  name        String
  startDate   DateTime
  endDate     DateTime
  order       Int
  country     String?
  countryCode String?
  latitude    Float?
  longitude   Float?
  timezone    String?
  tripId      Int
  trip        Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  pois        Poi[]
  dayPlans    DayPlan[]
  createdAt   DateTime  @default(now())
}

// SQLite + Prisma does not support native enums — `category` and `timeSlot`
// are Strings constrained at the app layer (see src/lib/categories.ts and
// src/lib/slots.ts).
model Poi {
  id                       Int           @id @default(autoincrement())
  name                     String
  category                 String
  description              String?
  latitude                 Float?
  longitude                Float?
  imageUrl                 String?
  rating                   Float?
  bestTimeToVisit          String?
  estimatedDurationMinutes Int?
  tips                     String?
  // Discovery / enrichment fields
  placeId                  String?
  priceLevel               Int?          // 1 cheap – 4 expensive
  website                  String?
  phoneNumber              String?
  openingHours             String?       // human-readable display string
  photoUrl                 String?       // primary photo URL
  isUnescoSite             Boolean?      @default(false)
  inceptionYear            Int?
  wikidataId               String?
  cityId                   Int
  city        City          @relation(fields: [cityId], references: [id], onDelete: Cascade)
  activities  DayActivity[]
  createdAt   DateTime      @default(now())
}

model DayPlan {
  id         Int           @id @default(autoincrement())
  date       DateTime
  cityId     Int
  city       City          @relation(fields: [cityId], references: [id], onDelete: Cascade)
  activities DayActivity[]
  createdAt  DateTime      @default(now())

  @@unique([cityId, date])
}

model DayActivity {
  id        Int      @id @default(autoincrement())
  dayPlanId Int
  dayPlan   DayPlan  @relation(fields: [dayPlanId], references: [id], onDelete: Cascade)
  poiId     Int      @unique
  poi       Poi      @relation(fields: [poiId], references: [id], onDelete: Cascade)
  timeSlot  String
  order     Int
  createdAt DateTime @default(now())
}

// Per-POI enrichment cache keyed by place ID + source.
// Avoids re-fetching Wikidata / Google for the same physical place.
model PoiEnrichCache {
  id        Int      @id @default(autoincrement())
  placeId   String
  source    String   // "wikidata" | "google"
  payload   String   // JSON enrichment object
  cachedAt  DateTime @default(now())

  @@unique([placeId, source])
}
model PoiCache {
  id        Int      @id @default(autoincrement())
  cityName  String
  category  String
  source    String   // e.g. "geoapify"
  payload   String   // JSON array of RecommendedPoi
  cachedAt  DateTime @default(now())

  @@unique([cityName, category, source])
}
