generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  color     String    @default("#3B82F6")
  avatar    String?   // emoji, e.g. "🧑‍💻"
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  trips          Trip[]
  favouriteLists FavouriteList[]
  poiRatings     PoiRating[]
}

model Trip {
  id         Int        @id @default(autoincrement())
  name       String
  startDate  DateTime
  endDate    DateTime
  archived   Boolean    @default(false)
  coverImage String?
  userId     Int
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  cities     City[]
  notes      TripNote[]

  @@index([userId])
}

model City {
  id            Int             @id @default(autoincrement())
  name          String
  nickname      String?
  startDate     DateTime
  endDate       DateTime
  order         Int
  country       String?
  countryCode   String?
  latitude      Float?
  longitude     Float?
  timezone         String?
  discoverRadiusKm Float?
  type                String    @default("destination") // "destination" | "stop"
  accommodationPoiId  Int?      // Selected accommodation POI (null = none selected)
  tripId              Int
  trip          Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  parentCityId  Int?
  parentCity    City?           @relation("CitySubcity", fields: [parentCityId], references: [id], onDelete: Cascade)
  subcities     City[]          @relation("CitySubcity")
  pois          Poi[]
  dayPlans      DayPlan[]
  candidates    PoiCandidate[]
  cityInfoCache CityInfoCache[]
  notes         TripNote[]
  createdAt     DateTime        @default(now())

  @@index([parentCityId])
}

model Poi {
  id                       Int           @id @default(autoincrement())
  name                     String
  category                 String
  description              String?
  latitude                 Float?
  longitude                Float?
  imageUrl                 String?
  rating                   Float?
  bestTimeToVisit          String?
  estimatedDurationMinutes Int?
  tips                     String?
  // Discovery / enrichment fields
  placeId                  String?
  priceLevel               Int?          // 1 cheap – 4 expensive
  website                  String?
  phoneNumber              String?
  openingHours             String?       // human-readable display string
  photoUrl                 String?       // primary photo URL
  fee                      String?       // OSM fee tag, e.g. "yes", "no", "5 EUR"
  isUnescoSite             Boolean?      @default(false)
  inceptionYear            Int?
  wikidataId               String?
  score                    Float?        // final ranking score (0–100+)
  scoreBreakdown           String?       // JSON: {rating,proximity,notability,categoryMatch,hiddenGem,unesco,photo,preferences,total}
  userRatingCount          Int?
  subcategory              String?
  address                  String?       // reverse-geocoded from lat/lng
  notes                    String?       // user notes
  originalData             String?       // JSON snapshot of discovered values, saved on first user edit
  extraFields              Json?         // arbitrary extra data (synced from FavouriteItem.extraFields)
  favouriteItemId          Int?          // link to source FavouriteItem for auto-sync
  cityId                   Int
  city        City          @relation(fields: [cityId], references: [id], onDelete: Cascade)
  activities  DayActivity[]
  poiRatings  PoiRating[]
  createdAt   DateTime      @default(now())

  @@index([favouriteItemId])
}

model DayPlan {
  id         Int           @id @default(autoincrement())
  date       DateTime
  cityId     Int
  city       City          @relation(fields: [cityId], references: [id], onDelete: Cascade)
  activities DayActivity[]
  notes      TripNote[]
  createdAt  DateTime      @default(now())

  @@unique([cityId, date])
}

model DayActivity {
  id        Int      @id @default(autoincrement())
  dayPlanId Int
  dayPlan   DayPlan  @relation(fields: [dayPlanId], references: [id], onDelete: Cascade)
  poiId     Int
  poi       Poi      @relation(fields: [poiId], references: [id], onDelete: Cascade)
  timeSlot  String
  order     Int
  createdAt DateTime @default(now())
}

// All scored candidates from a Discover run — selected and rejected alike.
// Cleared and repopulated on each run so you always see the latest state.
model PoiCandidate {
  id             Int      @id @default(autoincrement())
  cityId         Int
  city           City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  name           String
  category       String
  placeId        String?
  latitude       Float?
  longitude      Float?
  distanceKm     Float?
  googleRating   Float?   // Google pre-scan rating
  reviewCount    Int?
  score          Float?   // pre-enrichment ranking score
  scoreBreakdown String?  // JSON breakdown
  subcategory    String?
  selected       Boolean  @default(false)
  rejectedReason String?  // "quality_filter" | "not_top_n" | "duplicate" | "existing" | "low_score"
  createdAt      DateTime @default(now())

  @@index([cityId])
}

// Per-POI enrichment cache keyed by place ID + source.
// Avoids re-fetching Wikidata / Google for the same physical place.
model PoiEnrichCache {
  id        Int      @id @default(autoincrement())
  placeId   String
  source    String   // "wikidata" | "google"
  payload   String   // JSON enrichment object
  cachedAt  DateTime @default(now())

  @@unique([placeId, source])
}
// AI-generated city information cache (one row per city, upserted on regenerate).
model CityInfoCache {
  id          Int      @id @default(autoincrement())
  cityId      Int
  type        String   @default("city-info") // "city-info" | "activities"
  city        City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  data        String   // JSON: GeneratedCityInfo or ActivityRecommendationsResult
  generatedAt DateTime @default(now())

  @@unique([cityId, type], name: "cityId_type")
}

model PoiCache {
  id        Int      @id @default(autoincrement())
  cityName  String
  category  String
  source    String   // e.g. "geoapify"
  payload   String   // JSON array of RecommendedPoi
  cachedAt  DateTime @default(now())

  @@unique([cityName, category, source])
}

// ── Trip Notes / Journal ────────────────────────────────────────────────────

model TripNote {
  id        Int      @id @default(autoincrement())
  tripId    Int?
  trip      Trip?    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  cityId    Int?
  city      City?    @relation(fields: [cityId], references: [id], onDelete: Cascade)
  dayPlanId Int?
  dayPlan   DayPlan? @relation(fields: [dayPlanId], references: [id], onDelete: Cascade)
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tripId])
  @@index([cityId])
  @@index([dayPlanId])
}

// ── Favourites ──────────────────────────────────────────────────────────────

model FavouriteList {
  id        Int              @id @default(autoincrement())
  name      String
  order     Int              @default(0)
  parentId  Int?
  parent    FavouriteList?   @relation("ListSublist", fields: [parentId], references: [id], onDelete: Cascade)
  sublists  FavouriteList[]  @relation("ListSublist")
  items     FavouriteItem[]
  userId    Int
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([parentId])
  @@index([userId])
}

model FavouriteItem {
  id             Int            @id @default(autoincrement())
  name           String
  category       String
  subcategory    String?
  country        String
  city           String
  address        String?
  latitude       Float
  longitude      Float
  description    String?
  notes          String?
  photoUrl       String?
  website        String?
  phoneNumber    String?
  openingHours   String?
  priceLevel     Int?           // 0 free – 4 expensive
  fee            String?        // e.g. "5 EUR"
  sourcePlaceId  String?        // dedup link to Google placeId
  visited        Boolean        @default(false)
  personalRating Int?           // 1-5 personal star rating
  extraFields    Json?
  order          Int            @default(0)
  listId         Int
  list           FavouriteList  @relation(fields: [listId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([listId])
  @@index([city])
  @@index([country])
}

// Tracks favourite+city pairs the user intentionally removed (deleted the auto-created POI).
// Prevents the sync from re-creating the POI on subsequent page loads.
model DismissedFavouriteCity {
  id              Int      @id @default(autoincrement())
  favouriteItemId Int
  cityId          Int
  createdAt       DateTime @default(now())

  @@unique([favouriteItemId, cityId])
  @@index([cityId])
}

model PoiRating {
  id            Int      @id @default(autoincrement())
  poiId         Int
  poi           Poi      @relation(fields: [poiId], references: [id], onDelete: Cascade)
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating        Int?     // 1-5 personal rating
  notInterested Boolean  @default(false)
  visited       Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([poiId, userId])
}
