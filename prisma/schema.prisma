generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Trip {
  id        Int      @id @default(autoincrement())
  name      String
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cities    City[]
}

model City {
  id            Int             @id @default(autoincrement())
  name          String
  startDate     DateTime
  endDate       DateTime
  order         Int
  country       String?
  countryCode   String?
  latitude      Float?
  longitude     Float?
  timezone      String?
  tripId        Int
  trip          Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  pois          Poi[]
  dayPlans      DayPlan[]
  candidates    PoiCandidate[]
  cityInfoCache CityInfoCache?
  createdAt     DateTime        @default(now())
}

model Poi {
  id                       Int           @id @default(autoincrement())
  name                     String
  category                 String
  description              String?
  latitude                 Float?
  longitude                Float?
  imageUrl                 String?
  rating                   Float?
  bestTimeToVisit          String?
  estimatedDurationMinutes Int?
  tips                     String?
  // Discovery / enrichment fields
  placeId                  String?
  priceLevel               Int?          // 1 cheap – 4 expensive
  website                  String?
  phoneNumber              String?
  openingHours             String?       // human-readable display string
  photoUrl                 String?       // primary photo URL
  fee                      String?       // OSM fee tag, e.g. "yes", "no", "5 EUR"
  isUnescoSite             Boolean?      @default(false)
  inceptionYear            Int?
  wikidataId               String?
  score                    Float?        // final ranking score (0–100+)
  scoreBreakdown           String?       // JSON: {rating,proximity,notability,categoryMatch,hiddenGem,unesco,photo,preferences,total}
  userRatingCount          Int?
  subcategory              String?
  cityId                   Int
  city        City          @relation(fields: [cityId], references: [id], onDelete: Cascade)
  activities  DayActivity[]
  createdAt   DateTime      @default(now())
}

model DayPlan {
  id         Int           @id @default(autoincrement())
  date       DateTime
  cityId     Int
  city       City          @relation(fields: [cityId], references: [id], onDelete: Cascade)
  activities DayActivity[]
  createdAt  DateTime      @default(now())

  @@unique([cityId, date])
}

model DayActivity {
  id        Int      @id @default(autoincrement())
  dayPlanId Int
  dayPlan   DayPlan  @relation(fields: [dayPlanId], references: [id], onDelete: Cascade)
  poiId     Int
  poi       Poi      @relation(fields: [poiId], references: [id], onDelete: Cascade)
  timeSlot  String
  order     Int
  createdAt DateTime @default(now())
}

// All scored candidates from a Discover run — selected and rejected alike.
// Cleared and repopulated on each run so you always see the latest state.
model PoiCandidate {
  id             Int      @id @default(autoincrement())
  cityId         Int
  city           City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  name           String
  category       String
  placeId        String?
  latitude       Float?
  longitude      Float?
  distanceKm     Float?
  googleRating   Float?   // Google pre-scan rating
  reviewCount    Int?
  score          Float?   // pre-enrichment ranking score
  scoreBreakdown String?  // JSON breakdown
  subcategory    String?
  selected       Boolean  @default(false)
  rejectedReason String?  // "quality_filter" | "not_top_n" | "duplicate" | "existing" | "low_score"
  createdAt      DateTime @default(now())

  @@index([cityId])
}

// Per-POI enrichment cache keyed by place ID + source.
// Avoids re-fetching Wikidata / Google for the same physical place.
model PoiEnrichCache {
  id        Int      @id @default(autoincrement())
  placeId   String
  source    String   // "wikidata" | "google"
  payload   String   // JSON enrichment object
  cachedAt  DateTime @default(now())

  @@unique([placeId, source])
}
// AI-generated city information cache (one row per city, upserted on regenerate).
model CityInfoCache {
  id          Int      @id @default(autoincrement())
  cityId      Int      @unique
  city        City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  data        String   // JSON: GeneratedCityInfo (categories + generatedAt)
  generatedAt DateTime @default(now())
}

model PoiCache {
  id        Int      @id @default(autoincrement())
  cityName  String
  category  String
  source    String   // e.g. "geoapify"
  payload   String   // JSON array of RecommendedPoi
  cachedAt  DateTime @default(now())

  @@unique([cityName, category, source])
}
